{# Usage: include 'mission/_delete_modal.html.twig' with {'id': mission.id, 'name': mission.productName} #}
<div class="modal fade" id="deleteModal{{ id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ id }}" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalLabel{{ id }}">Confirm Delete</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        Are you sure you want to delete this mission{% if name is defined %} "{{ name }}"{% endif %}?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
        <form action="{{ path('sagit_mission_delete', {'id': id}) }}" method="post" style="display:inline;">
            <input type="hidden" name="token" value="{{ csrf_token('delete-mission-' ~ id) }}">
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
      </div>
    </div>
  </div>
</div>
