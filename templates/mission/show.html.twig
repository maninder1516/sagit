{% extends 'base.html.twig' %}

{% block title %}Mission Details{% endblock %}

{% block body %}
<style>
    .mission-details { margin: 1em auto; max-width: 800px; width: 95%; font: 16px/1.5 sans-serif; }
    .detail-row { margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid #eee; }
    .detail-label { font-weight: bold; display: inline-block; width: 200px; }
    .btn-container { margin-top: 20px; }
    .btn { 
        display: inline-block; 
        padding: 8px 16px; 
        text-decoration: none; 
        border-radius: 4px; 
        margin-right: 10px;
    }
    .btn-primary { background-color: #007bff; color: white; }
    .btn-secondary { background-color: #6c757d; color: white; }
</style>

<div class="mission-details">
    <h1>Mission Details</h1>

    <div class="detail-row">
        <span class="detail-label">Service Date:</span>
        <span>{{ mission.serviceDate|date('Y-m-d') }}</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Product Name:</span>
        <span>{{ mission.productName }}</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Quantity:</span>
        <span>{{ mission.quantity }}</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Destination Country:</span>
        <span>{{ mission.destinationCountry }}</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Vendor Name:</span>
        <span>{{ mission.vendorName }}</span>
    </div>

    <div class="detail-row">
        <span class="detail-label">Vendor Email:</span>
        <span>{{ mission.vendorEmail }}</span>
    </div>

    <div class="btn-container">
        {% if is_granted('EDIT', mission) %}
            <a href="{{ path('sagit_mission_edit', {'id': mission.id}) }}" class="btn btn-primary">Edit</a>
        {% endif %}
        <a href="{{ path('sagit_mission') }}" class="btn btn-secondary">Back to list</a>
    </div>
</div>
{% endblock %}
