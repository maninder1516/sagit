{% extends 'baseizmo.html.twig' %}

{% block title %}New Mission{% endblock %}

{% block content %}
<div class="container-xl">
    <div class="table-responsive">
        <div class="table-wrapper">
            <div class="table-title">
				<div class="row">
					<div class="col-sm-6">
						<h2>Create New <b>Mission</b></h2>
					</div>
					<div class="col-sm-6">
                        <a href="{{ path('sagit_mission_index') }}" class="btn btn-info"><i class="material-icons">&#xE860;</i><span>Back to List</span></a>												
					</div>
				</div>
			</div>
            <div id="divFormMission"> 
                {{ form_start(form) }}
                    <div class="form-row">                        
                        <div class="form-group col-md-6">
                            <label for="inputPassword4">{{ form_label(form.productName) }} </label>
                            {{ form_widget(form.productName, {'attr': {'class': 'form-control'} }) }}                           
                            {{ form_errors(form.productName) }}
                        </div>
                        <div class="form-group col-md-6">
                            <label for="inputEmail4">{{ form_label(form.serviceDate) }}</label>
                            {{ form_widget(form.serviceDate, {'attr': {'class': 'form-control'} }) }}                            
                            {{ form_errors(form.serviceDate) }}
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="inputEmail4">{{ form_label(form.quantity) }}</label>
                            {{ form_widget(form.quantity, {'attr': {'class': 'form-control'} }) }}                            
                            {{ form_errors(form.quantity) }}
                        </div>
                        <div class="form-group col-md-6">
                            <label for="inputPassword4">{{ form_label(form.destinationCountry) }} </label>
                            {{ form_widget(form.destinationCountry, {'attr': {'class': 'form-control'} }) }}                           
                            {{ form_errors(form.destinationCountry) }}
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label for="inputEmail4">{{ form_label(form.vendorName) }}</label>
                            {{ form_widget(form.vendorName, {'attr': {'class': 'form-control'} }) }}                            
                            {{ form_errors(form.vendorName) }}
                        </div>
                        <div class="form-group col-md-6">
                            <label for="inputPassword4">{{ form_label(form.vendorEmail) }} </label>
                            {{ form_widget(form.vendorEmail, {'attr': {'class': 'form-control'} }) }}                           
                            {{ form_errors(form.vendorEmail) }}
                        </div>
                    </div>
                    <div class="btn-container">
                        <button type="submit" class="btn btn-primary">Create Mission</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
