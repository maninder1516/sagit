{% extends 'baseizmo.html.twig' %}

{% block title %}Missions{% endblock %}

{% block content %}
<!-- Main content -->
<div class="container-xl">
     <div class="table-responsive">
        <div class="table-wrapper">
            <div class="table-title">
				<div class="row">
                    <div class="col-sm-6">
                        <h2>Manage <b>Missions</b></h2>
                    </div>
                    <div class="col-sm-6 text-right">
                        <a href="{{ path('sagit_logout') }}" class="btn btn-danger ml-2">
                            <i class="material-icons">exit_to_app</i> <span>Logout</span>
                        </a>
                        {% if is_granted('ROLE_CLIENT') %}
                            <a href="{{ path('sagit_mission_new') }}" class="btn btn-success">
                                <i class="material-icons">&#xE147;</i> <span>Create New Mission</span>
                            </a>
                        {% endif %}                        
                    </div>
                </div>
            </div>
    
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">
            {{ message }}
        </div>
    {% endfor %}
    
    <div class="filters">
        <h3>Filters : </h3>
        {{ form_start(filter_form) }}
            <div class="row">
                <div class="col-md-4">
                    {{ form_row(filter_form.productName) }}                    
                </div>
                <div class="col-md-4">
                    {{ form_row(filter_form.destinationCountry) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(filter_form.serviceDate) }}
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Apply Filters</button>
            <a href="{{ path('sagit_mission_index') }}" class="btn btn-secondary">Reset</a>
        {{ form_end(filter_form) }}
    </div>
    
    {% if no_results %}
        <div class="no-data">
            <h3>No missions found</h3>
            <p>There are no missions matching your criteria.</p>
        </div>
    {% else %}
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Service Date</th>
                    <th>Product Name</th>
                    <th>Quantity</th>
                    <th>Destination Country</th>
                    <th>Vendor</th>
                    <th>Client</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for mission in missions %}
                    <tr>
                        <td>{{ mission.serviceDate|date('Y-m-d') }}</td>
                        <td>{{ mission.productName }}</td>
                        <td>{{ mission.quantity }}</td>
                        <td>{{ mission.destinationCountry }}</td>
                        <td>{{ mission.vendorName }}</td>
                        <td>{{ mission.client.email }}</td>
                        <td>
                            {# {% if is_granted('ROLE_CLIENT') %}
                                <a href="{{ path('sagit_mission_edit', {'id': mission.id}) }}" class="edit"><i class="material-icons" title="Edit">&#xE254;</i></a>
                            {% endif %}                             #}
                            <a href=/mission/view/{{mission.id}} class="view"><i class="material-icons" title="View">&#xE417;</i></a>
                            {% if is_granted('ROLE_CLIENT') %}
                                <a href=/mission/edit/{{mission.id}} class="edit"><i class="material-icons" title="Edit">&#xE254;</i></a>
                            {% endif %}
                            
                            <a href="javascript:void(0)" class="delete" data-toggle="modal" data-target="#deleteModal{{ mission.id }}"><i class="material-icons" title="Delete">&#xE872;</i></a>                                                   
                        </td>
                    </tr>
                    
                    {# Include the shared delete modal template #}
                    {% include 'mission/_delete_modal.html.twig' with {
                        'id': mission.id,
                        'name': mission.productName
                    } %}
                {% endfor %}
            </tbody>
        </table>
        
        <div class="pagination">
            {% if missions is defined and missions|length > 0 %}
                {{ knp_pagination_render(missions) }}
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
