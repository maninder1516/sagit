{% extends 'baseizmo.html.twig' %}

{% block title %}Missions{% endblock %}

{% block content %}
<!-- Main content -->
<div class="container-xl">
     <div class="table-responsive">
        <div class="table-wrapper">
            <div class="table-title">
				<div class="row">
                    <div class="col-sm-6">
                        <h2>Manage <b>Missions</b></h2>
                    </div>
                    <div class="col-sm-6 text-right">
                        {% if is_granted('ROLE_CLIENT') %}
                            <a href="{{ path('sagit_mission_new') }}" class="btn btn-success">
                                <i class="material-icons">&#xE147;</i> <span>Create New Mission</span>
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
    
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning">
            {{ message }}
        </div>
    {% endfor %}
    
    <div class="filters">
        <h3>Filter Missions</h3>
        {{ form_start(filter_form) }}
            <div class="row">
                <div class="col-md-4">
                    {{ form_row(filter_form.productName) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(filter_form.destinationCountry) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(filter_form.serviceDate) }}
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Apply Filters</button>
            <a href="{{ path('sagit_mission') }}" class="btn btn-secondary">Reset</a>
        {{ form_end(filter_form) }}
    </div>
    
    {% if no_results %}
        <div class="no-data">
            <h3>No missions found</h3>
            <p>There are no missions matching your criteria.</p>
        </div>
    {% else %}
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Service Date</th>
                    <th>Product Name</th>
                    <th>Quantity</th>
                    <th>Destination Country</th>
                    <th>Vendor</th>
                    <th>Client</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for mission in missions %}
                    <tr>
                        <td>{{ mission.serviceDate|date('Y-m-d') }}</td>
                        <td>{{ mission.productName }}</td>
                        <td>{{ mission.quantity }}</td>
                        <td>{{ mission.destinationCountry }}</td>
                        <td>{{ mission.vendorName }}</td>
                        <td>{{ mission.client.email }}</td>
                        <td>
                            <a href="#" class="btn btn-sm btn-info">View</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        
        <div class="pagination">
            {% if missions is defined and missions|length > 0 %}
                {{ knp_pagination_render(missions) }}
            {% endif %}
        </div>
    {% endif %}
</div>
{% endblock %}
