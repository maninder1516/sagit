{% extends 'base.html.twig' %}

{% block title %}Missions!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    .logout-btn { 
        display: inline-block;
        padding: 8px 16px;
        background-color: #dc3545;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        margin-top: 20px;
    }
    .logout-btn:hover {
        background-color: #c82333;
        color: white;
        text-decoration: none;
    }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>/websites/sagit/src/Controller/MissionController.php</code></li>
        <li>Your template at <code>/websites/sagit/templates/mission/index.html.twig</code></li>
    </ul>
    
    <a href="{{ path('sagit_logout') }}" class="logout-btn">Logout</a>
</div>
{% endblock %}
