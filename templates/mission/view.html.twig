{% extends 'baseizmo.html.twig' %}
{% block title %}Mission Details{% endblock %}
{% block content %}
<div class="container-xl">
   <div class="table-responsive">
      <div class="table-wrapper">
         <div class="table-title">
            <div class="row">
               <div class="col-sm-6">
                  <h2>Mission <b>Details</b></h2>
               </div>
               <div class="col-sm-6 text-right">
                  {% if is_granted('EDIT', mission) %}
                  <a href="{{ path('sagit_mission_edit', {'id': mission.id}) }}" class="btn btn-primary">
                  <i class="material-icons">edit</i> <span>Edit</span>
                  </a>
                  <!-- Use button to trigger modal instead of direct link -->
                  <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#deleteModal{{ mission.id }}">
                    <i class="material-icons">delete</i> <span>Delete</span>
                  </button>
                  {% endif %}
                  <a href="{{ path('sagit_mission_index') }}" class="btn btn-secondary">
                  <i class="material-icons">arrow_back</i> <span>Back to List</span>
                  </a>
               </div>
            </div>
         </div>
         <div class="card">
            <div class="card-body">
               <div class="row mb-3">
                  <div class="col-md-3 font-weight-bold">Service Date:</div>
                  <div class="col-md-9">{{ mission.serviceDate|date('Y-m-d') }}</div>
               </div>
               <div class="row mb-3">
                  <div class="col-md-3 font-weight-bold">Product Name:</div>
                  <div class="col-md-9">{{ mission.productName }}</div>
               </div>
               <div class="row mb-3">
                  <div class="col-md-3 font-weight-bold">Quantity:</div>
                  <div class="col-md-9">{{ mission.quantity }}</div>
               </div>
               <div class="row mb-3">
                  <div class="col-md-3 font-weight-bold">Destination Country:</div>
                  <div class="col-md-9">{{ mission.destinationCountry }}</div>
               </div>
               <div class="row mb-3">
                  <div class="col-md-3 font-weight-bold">Vendor Name:</div>
                  <div class="col-md-9">{{ mission.vendorName }}</div>
               </div>
               <div class="row mb-3">
                  <div class="col-md-3 font-weight-bold">Vendor Email:</div>
                  <div class="col-md-9">{{ mission.vendorEmail }}</div>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>

{# Include the shared delete modal template at the end of the page #}
{% include 'mission/_delete_modal.html.twig' with {
    'id': mission.id,
    'name': mission.productName
} %}
{% endblock %}